---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  lang: 'en' | 'zh';
  alternateUrl?: string;
  heroImage?: string;
  author?: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags = [],
  lang,
  alternateUrl,
  heroImage,
  author = 'Tsu',
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const formattedDate = pubDate.toLocaleDateString(lang === 'zh' ? 'zh-TW' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  alternateUrl={alternateUrl}
  image={heroImage}
>
  <article class="mx-auto max-w-3xl px-6 py-12 md:py-16">
    <!-- Breadcrumb & Language Switch Banner if alternative exists -->
    <div class="mb-8 flex items-center justify-between text-xs text-[var(--text-muted)]">
      <a
        href={`${baseUrl}/${lang}/`}
        class="inline-flex items-center gap-1 hover:text-[var(--text-primary)] transition"
      >
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>{lang === 'en' ? 'Back to Articles' : '返回文章列表'}</span>
      </a>

      {alternateUrl && (
        <a
          href={alternateUrl}
          class="inline-flex items-center gap-1 rounded bg-[var(--bg-secondary)] border border-[var(--border-color)] px-2 py-0.5 text-xs text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition"
        >
          <span>{lang === 'en' ? '閱讀中文版 ➔' : 'Read in English ➔'}</span>
        </a>
      )}
    </div>

    <!-- Article Header -->
    <header class="mb-12 border-b border-[var(--border-color)] pb-10">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        {tags.map((tag) => (
          <span class="rounded-full bg-[var(--bg-secondary)] border border-[var(--border-color)] px-2.5 py-0.5 text-xs font-medium text-[var(--text-secondary)]">
            #{tag}
          </span>
        ))}
      </div>

      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl md:text-5xl text-[var(--text-primary)] leading-[1.18]">
        {title}
      </h1>

      <p class="mt-4 text-lg md:text-xl text-[var(--text-secondary)] font-normal leading-relaxed">
        {description}
      </p>

      <div class="mt-8 flex items-center gap-4 text-xs text-[var(--text-muted)]">
        <div class="flex items-center gap-2">
          <div class="h-7 w-7 rounded-full bg-[var(--accent)]/10 text-[var(--accent)] flex items-center justify-center font-bold text-xs">
            {author.charAt(0)}
          </div>
          <span class="font-medium text-[var(--text-secondary)]">{author}</span>
        </div>
        <span>•</span>
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        {updatedDate && (
          <>
            <span>•</span>
            <span>(Updated: {updatedDate.toLocaleDateString(lang === 'zh' ? 'zh-TW' : 'en-US')})</span>
          </>
        )}
      </div>
    </header>

    <!-- Post Body -->
    <div class="prose-custom">
      <slot />
    </div>

    <!-- Article Footer -->
    <footer class="mt-16 border-t border-[var(--border-color)] pt-8 flex items-center justify-between text-sm">
      <a
        href={`${baseUrl}/${lang}/`}
        class="inline-flex items-center gap-2 text-[var(--accent)] hover:underline"
      >
        <span>← {lang === 'en' ? 'Explore all research articles' : '探索所有研究文章'}</span>
      </a>

      {alternateUrl && (
        <a
          href={alternateUrl}
          class="rounded-lg border border-[var(--border-color)] bg-[var(--bg-secondary)] px-3 py-1.5 text-xs font-medium hover:border-[var(--accent)] transition"
        >
          {lang === 'en' ? '切換至繁體中文' : 'Switch to English'}
        </a>
      )}
    </footer>
  </article>
</BaseLayout>
