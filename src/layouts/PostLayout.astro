---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  lang: 'en' | 'zh';
  alternateUrl?: string;
  author?: string;
}

const {
  title,
  description,
  pubDate,
  lang,
  alternateUrl,
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const formattedDate = pubDate.toLocaleDateString(lang === 'zh' ? 'zh-TW' : 'en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  alternateUrl={alternateUrl}
>
  <article class="mx-auto max-w-[640px] px-6 py-12 md:py-16">
    <header class="mb-8">
      <div class="mb-4 flex items-center justify-between text-xs text-[var(--text-faint)]">
        <a href={`${baseUrl}/${lang}/`} class="hover:text-[var(--text-muted)] transition">
          ← {lang === 'en' ? 'Index' : '目錄'}
        </a>
        <div class="flex items-center gap-3">
          <time datetime={pubDate.toISOString()}>{formattedDate}</time>
          {alternateUrl && (
            <span>•</span>
            <a href={alternateUrl} class="hover:text-[var(--text-muted)] transition underline underline-offset-2">
              {lang === 'en' ? '切換中文' : 'English'}
            </a>
          )}
        </div>
      </div>

      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--text)]">
        {title}
      </h1>
      {description && (
        <p class="mt-2 text-sm text-[var(--text-muted)] leading-relaxed">
          {description}
        </p>
      )}
    </header>

    <div class="article-body">
      <slot />
    </div>
  </article>
</BaseLayout>
