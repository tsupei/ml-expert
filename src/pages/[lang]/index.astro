---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'zh' } },
  ];
}

const { lang } = Astro.params;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const posts = (await getCollection('blog', ({ data }) => {
  return data.lang === lang;
})).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function getPostSlug(post: any) {
  return post.id.replace(/^(en|zh)\//, '').replace(/\.(md|mdx)$/, '');
}
---

<BaseLayout
  title={lang === 'en' ? 'Notes' : '筆記'}
  lang={lang as 'en' | 'zh'}
  alternateUrl={`${baseUrl}/${lang === 'en' ? 'zh' : 'en'}/`}
>
  <div class="mx-auto max-w-[640px] px-6 py-12 md:py-16">
    <div class="mb-10">
      <h1 class="text-xl font-bold tracking-tight text-[var(--text)]">
        {lang === 'en' ? 'Machine Learning Notes' : '機器學習觀念筆記'}
      </h1>
      <p class="mt-1 text-sm text-[var(--text-muted)]">
        {lang === 'en' ? 'Concise notes on ML architectures and systems.' : '簡潔的機器學習架構與系統觀念。'}
      </p>
    </div>

    <div class="divide-y divide-[var(--border)]">
      {posts.length === 0 ? (
        <p class="text-sm text-[var(--text-faint)] py-4">
          {lang === 'en' ? 'No notes yet.' : '尚無筆記。'}
        </p>
      ) : (
        posts.map((post) => {
          const postSlug = getPostSlug(post);
          const postUrl = `${baseUrl}/${lang}/posts/${postSlug}/`;
          const formattedDate = post.data.pubDate.toLocaleDateString(
            lang === 'zh' ? 'zh-TW' : 'en-US',
            { year: 'numeric', month: 'short', day: 'numeric' }
          );

          return (
            <article class="py-4 first:pt-0 last:pb-0">
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                <h2 class="text-base font-semibold text-[var(--text)] hover:underline">
                  <a href={postUrl}>{post.data.title}</a>
                </h2>
                <time class="text-xs text-[var(--text-faint)] font-mono shrink-0" datetime={post.data.pubDate.toISOString()}>
                  {formattedDate}
                </time>
              </div>
              {post.data.description && (
                <p class="mt-1 text-sm text-[var(--text-muted)] leading-relaxed">
                  {post.data.description}
                </p>
              )}
            </article>
          );
        })
      )}
    </div>
  </div>
</BaseLayout>
