---
interface Props {
  type?: 'note' | 'tip' | 'warning' | 'intuition';
  title?: string;
}

const { type = 'note', title } = Astro.props;

const styles = {
  note: 'border-l-4 border-blue-500 bg-blue-50/50 dark:bg-blue-950/20 text-blue-950 dark:text-blue-100',
  tip: 'border-l-4 border-emerald-500 bg-emerald-50/50 dark:bg-emerald-950/20 text-emerald-950 dark:text-emerald-100',
  warning: 'border-l-4 border-amber-500 bg-amber-50/50 dark:bg-amber-950/20 text-amber-950 dark:text-amber-100',
  intuition: 'border-l-4 border-purple-500 bg-purple-50/50 dark:bg-purple-950/20 text-purple-950 dark:text-purple-100',
};

const defaultTitles = {
  note: 'Key Takeaway',
  tip: 'Practical Tip',
  warning: 'Caveat & Nuance',
  intuition: 'Mathematical Intuition',
};

const displayTitle = title || defaultTitles[type];
---

<aside class={`my-6 rounded-r-lg p-4 text-sm leading-relaxed transition-colors ${styles[type]}`}>
  {displayTitle && (
    <div class="mb-1 font-semibold tracking-wide uppercase text-xs opacity-90">
      {displayTitle}
    </div>
  )}
  <div class="callout-body font-normal opacity-95">
    <slot />
  </div>
</aside>
