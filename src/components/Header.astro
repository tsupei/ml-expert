---
interface Props {
  currentLang?: 'en' | 'zh';
  alternateUrl?: string;
}

const { currentLang = 'en', alternateUrl } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// Compute fallback translation target if alternateUrl is not explicitly passed
const targetLang = currentLang === 'en' ? 'zh' : 'en';
const langSwitchLabel = currentLang === 'en' ? '繁體中文' : 'English';
const langSwitchHref = alternateUrl || `${baseUrl}/${targetLang}/`;
---

<header class="sticky top-0 z-50 border-b border-[var(--border-color)] bg-[var(--bg-primary)]/80 backdrop-blur-md transition-colors">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <!-- Brand / Logo -->
    <a href={`${baseUrl}/${currentLang}/`} class="group flex items-center gap-2 text-decoration-none">
      <span class="inline-flex h-7 w-7 items-center justify-center rounded-lg bg-[var(--text-primary)] text-xs font-bold text-[var(--bg-primary)] transition group-hover:scale-105">
        ML
      </span>
      <span class="text-base font-semibold tracking-tight text-[var(--text-primary)]">
        EXPERT <span class="text-xs font-normal text-[var(--text-muted)]">Research & Engineering</span>
      </span>
    </a>

    <!-- Nav Items & Utilities -->
    <div class="flex items-center gap-6 text-sm">
      <nav class="hidden md:flex items-center gap-6">
        <a href={`${baseUrl}/${currentLang}/`} class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition font-medium">
          {currentLang === 'en' ? 'Articles' : '文章列表'}
        </a>
        <a href="https://github.com/tsupei/ml-expert" target="_blank" rel="noopener noreferrer" class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition font-medium">
          GitHub
        </a>
      </nav>

      <div class="h-4 w-[1px] bg-[var(--border-color)] hidden md:block"></div>

      <!-- Language Switcher -->
      <a
        href={langSwitchHref}
        class="inline-flex items-center gap-1.5 rounded-full border border-[var(--border-color)] px-3 py-1 text-xs font-medium text-[var(--text-secondary)] hover:bg-[var(--bg-secondary)] hover:text-[var(--text-primary)] transition"
        title={currentLang === 'en' ? '切換至繁體中文' : 'Switch to English'}
      >
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
        </svg>
        <span>{langSwitchLabel}</span>
      </a>

      <!-- Dark Mode Toggle Button -->
      <button
        id="theme-toggle"
        type="button"
        class="rounded-full p-2 text-[var(--text-secondary)] hover:bg-[var(--bg-secondary)] hover:text-[var(--text-primary)] transition focus:outline-none"
        aria-label="Toggle dark mode"
      >
        <!-- Sun icon (for dark mode) -->
        <svg id="theme-toggle-light-icon" class="hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Moon icon (for light mode) -->
        <svg id="theme-toggle-dark-icon" class="hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  const themeToggle = document.getElementById('theme-toggle');
  const lightIcon = document.getElementById('theme-toggle-light-icon');
  const darkIcon = document.getElementById('theme-toggle-dark-icon');

  function updateIcons(isDark) {
    if (isDark) {
      lightIcon?.classList.remove('hidden');
      darkIcon?.classList.add('hidden');
    } else {
      lightIcon?.classList.add('hidden');
      darkIcon?.classList.remove('hidden');
    }
  }

  const isDarkMode = document.documentElement.classList.contains('dark');
  updateIcons(isDarkMode);

  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    updateIcons(isDark);
  });
</script>
