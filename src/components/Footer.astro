---
interface Props {
  currentLang?: 'en' | 'zh';
}

const { currentLang = 'en' } = Astro.props;
---

<footer class="mt-20 border-t border-[var(--border)] py-8 transition-colors">
  <div class="mx-auto flex max-w-[640px] items-center justify-between px-6 text-xs text-[var(--text-faint)]">
    <div>
      {currentLang === 'en' ? 'ML Notes & Systems' : '機器學習觀念與系統筆記'}
    </div>
    <div>
      <a href="https://github.com/tsupei/ml-expert" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--text-muted)] transition">
        GitHub
      </a>
    </div>
  </div>
</footer>
